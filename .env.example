# ==============================================================================
# Agafari Platform - Unified Environment Configuration Example
# Copy this file to .env or frontend/.env and replace placeholders with secure values.
# NEVER COMMIT REAL CREDENTIALS, SECRETS, OR CERTIFICATES TO GIT.
# ==============================================================================

# Node Environment
NODE_ENV="development"

# Application Base URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (MySQL 8.0+)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="agafari"
MYSQL_USER="agafari_app"
MYSQL_PASSWORD="replace_with_strong_database_password"

# Cryptographic & Session Secrets (Mandatory in Production, min 32 characters)
TICKET_SIGNING_SECRET="replace_with_high_entropy_32_character_signing_key_here"
JWT_SECRET="replace_with_high_entropy_32_character_jwt_secret_here"

# Scheduled Tasks / Cron Security
CRON_SECRET="replace_with_random_cron_authentication_token"

# Optional: Upstash Redis for Multi-Instance Rate Limiting & Session Storage
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_with_upstash_rest_token"

# Optional: Sentry Error Monitoring & Telemetry
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# Optional: Cloudflare CDN & Tunnel
CLOUDFLARE_TUNNEL_TOKEN="replace_with_cloudflare_tunnel_token"
