# Agafari Monolith Environment Configuration Template

# Database Connection (MySQL on AWS RDS / PlanetScale / Railway / Aiven)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_DATABASE="agafari"
MYSQL_USER="agafari_app"
MYSQL_PASSWORD="your_secure_mysql_password_here"

# Public App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# HMAC Ticket Signing Secret (Mandatory in production: min 32 characters)
TICKET_SIGNING_SECRET="your_32byte_random_ticket_signing_hmac_secret_key"

# Session JWT Signing Secret (Mandatory in production: min 32 characters)
JWT_SECRET="your_32byte_random_jwt_session_signing_secret_key"

# Cron Job Authorization Key
CRON_SECRET="your_cron_job_auth_secret_key"

# Upstash Redis Rate Limiting (Optional in local dev, recommended in production)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# Sentry Error Tracking DSN (Optional in local dev)
SENTRY_DSN="https://your_sentry_dsn_key@o0.ingest.sentry.io/0"
NEXT_PUBLIC_SENTRY_DSN="https://your_sentry_dsn_key@o0.ingest.sentry.io/0"
