# --- Database ---
DATABASE_URL=postgres://user:pass@host:5432/agafari
DATABASE_SSL=false                     # set to "true" for managed Postgres (Supabase/Neon/RDS) requiring SSL

# --- Auth ---
JWT_SECRET=                            # required — generate with: openssl rand -base64 48
                                        # no hardcoded fallback on purpose; the app refuses to start without this

# --- QR / ticket signing (separate secret from JWT on purpose) ---
TICKET_SIGNING_SECRET=                 # required — generate with: openssl rand -base64 48

# --- Scheduled jobs ---
CRON_SECRET=                           # required — protects POST /api/cron/lock-rsvps from public calls

# --- Public URL (used to build QR/invite links) ---
PUBLIC_APP_URL=https://your-domain.example
